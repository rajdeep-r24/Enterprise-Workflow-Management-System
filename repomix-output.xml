@login_required
@role_required(
    "MANAGER",
    "HR_HEAD",
    "IT_HEAD",
    "UNIT_HEAD",
    "ADMIN",
    "ORG_ADMIN",
    "SUPER_ADMIN",
)
def approval_history(request):

    history = (
        WorkflowStepInstance.objects
        .select_related(
            "workflow_instance",
            "workflow_instance__initiated_by",
            "workflow_instance__formsubmission",
            "workflow_instance__formsubmission__form",
