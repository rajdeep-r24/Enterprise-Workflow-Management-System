  border-radius: var(--radius-full);
  background: var(--primary-subtle);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
  flex-shrink: 0;
}

/* Mobile */
@media (max-width: 900px) {
  .ff-sidebar {
    position: fixed;
    left: 0; top: 0;
    transform: translateX(-100%);
    box-shadow: var(--shadow-lg);
  }
  .ff-shell.is-mobile-open .ff-sidebar { transform: translateX(0); width: var(--sidebar-w); }
  .ff-content { padding: var(--space-4); }
}

/* -------------------------------------------------------------------------
   4. Buttons
   ------------------------------------------------------------------------- */
.ff-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: 38px;
  padding: 0 var(--space-4);
  border-radius: var(--radius-sm);
  font-size: 13.5px;
  font-weight: 600;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), color var(--transition);
  white-space: nowrap;
}

.ff-btn:focus-visible { outline: none; box-shadow: var(--focus-ring); }

.ff-btn--primary { background: var(--primary); color: var(--text-on-primary); box-shadow: var(--shadow-xs); }
.ff-btn--primary:hover { background: var(--primary-hover); color: var(--text-on-primary); }

.ff-btn--secondary { background: var(--surface); color: var(--text-primary); border-color: var(--border-strong); }
.ff-btn--secondary:hover { background: var(--neutral-subtle); color: var(--text-primary); }

.ff-btn--ghost { background: transparent; color: var(--text-secondary); }
.ff-btn--ghost:hover { background: var(--neutral-subtle); color: var(--text-primary); }

.ff-btn--danger { background: var(--danger-subtle); color: var(--danger); border-color: var(--danger-border); }
.ff-btn--danger:hover { background: var(--danger); color: #fff; }

.ff-btn--sm { height: 32px; padding: 0 var(--space-3); font-size: 12.5px; }
.ff-btn--lg { height: 46px; padding: 0 var(--space-6); font-size: 14.5px; }
.ff-btn--block { width: 100%; }
.ff-btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* -------------------------------------------------------------------------
   5. Forms
   ------------------------------------------------------------------------- */
.ff-field { margin-bottom: var(--space-5); }

.ff-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-2);
}

.ff-help { font-size: 12px; color: var(--text-muted); margin-top: var(--space-1); }
.ff-error-text { font-size: 12px; color: var(--danger); margin-top: var(--space-1); font-weight: 500; }

.ff-input,
.ff-select,
.ff-textarea {
  width: 100%;
  height: 40px;
  padding: 0 var(--space-3);
  font-size: 13.5px;
  font-family: var(--font-sans);
  color: var(--text-primary);
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  transition: border-color var(--transition), box-shadow var(--transition);
}

.ff-textarea { height: auto; min-height: 96px; padding: var(--space-3); resize: vertical; }

.ff-input::placeholder, .ff-textarea::placeholder { color: var(--text-muted); }

.ff-input:focus, .ff-select:focus, .ff-textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: var(--focus-ring);
}

.ff-input.is-invalid, .ff-textarea.is-invalid { border-color: var(--danger); }

.ff-checkbox-row { display: flex; align-items: center; gap: var(--space-2); }
.ff-checkbox-row input { width: 16px; height: 16px; accent-color: var(--primary); }

/* -------------------------------------------------------------------------
   6. Cards
   ------------------------------------------------------------------------- */
.ff-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.ff-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-6);
  border-bottom: 1px solid var(--border);
}

.ff-card__title { font-size: 15px; font-weight: 600; margin: 0; }
.ff-card__subtitle { font-size: 12.5px; color: var(--text-muted); margin-top: 2px; }
.ff-card__body { padding: var(--space-6); }
.ff-card__footer { padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); background: var(--bg-inset); border-radius: 0 0 var(--radius-lg) var(--radius-lg); }

.ff-stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition), transform var(--transition);
}

a.ff-stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }

.ff-stat-card__label { font-size: 12.5px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
.ff-stat-card__value { font-size: 28px; font-weight: 700; margin-top: var(--space-2); letter-spacing: -0.02em; }
.ff-stat-card__icon {
  width: 38px; height: 38px; border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; margin-bottom: var(--space-3);
}

.ff-grid { display: grid; gap: var(--space-5); }
.ff-grid--4 { grid-template-columns: repeat(4, 1fr); }
.ff-grid--3 { grid-template-columns: repeat(3, 1fr); }
.ff-grid--2 { grid-template-columns: repeat(2, 1fr); }
@media (max-width: 1100px) { .ff-grid--4 { grid-template-columns: repeat(2, 1fr); } .ff-grid--3 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .ff-grid--4, .ff-grid--3, .ff-grid--2 { grid-template-columns: 1fr; } }

/* -------------------------------------------------------------------------
   7. Badges / status pills
   ------------------------------------------------------------------------- */
.ff-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 3px var(--space-3);
  border-radius: var(--radius-full);
  font-size: 11.5px;
  font-weight: 600;
  border: 1px solid transparent;
  white-space: nowrap;
}

.ff-badge--success { background: var(--success-subtle); color: var(--success); border-color: var(--success-border); }
.ff-badge--warning { background: var(--warning-subtle); color: var(--warning); border-color: var(--warning-border); }
.ff-badge--danger  { background: var(--danger-subtle); color: var(--danger); border-color: var(--danger-border); }
.ff-badge--info    { background: var(--info-subtle); color: var(--info); border-color: var(--info-border); }
.ff-badge--neutral { background: var(--neutral-subtle); color: var(--text-secondary); border-color: var(--neutral-border); }

.ff-badge__dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

/* -------------------------------------------------------------------------
   8. Tables
   ------------------------------------------------------------------------- */
.ff-table-wrap { overflow-x: auto; }

.ff-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }

.ff-table th {
  text-align: left;
  padding: var(--space-3) var(--space-4);
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}

.ff-table td {
  padding: var(--space-4);
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  vertical-align: middle;
}

.ff-table tbody tr { transition: background var(--transition); }
.ff-table tbody tr:hover { background: var(--bg-inset); }
.ff-table tbody tr:last-child td { border-bottom: none; }

.ff-table__empty { text-align: center; padding: var(--space-12); color: var(--text-muted); }

/* -------------------------------------------------------------------------
   9. Timeline (approval chain — the signature ForgeFlow element)
   ------------------------------------------------------------------------- */
.ff-timeline { list-style: none; margin: 0; padding: 0; }

.ff-timeline__item {
  position: relative;
  padding-left: var(--space-8);
  padding-bottom: var(--space-6);
}

.ff-timeline__item:last-child { padding-bottom: 0; }

.ff-timeline__item::before {
  content: "";
  position: absolute;
  left: 11px;
  top: 26px;
  bottom: 0;
  width: 2px;
  background: var(--border);
}

.ff-timeline__item:last-child::before { display: none; }

.ff-timeline__dot {
  position: absolute;
  left: 0; top: 2px;
  width: 24px; height: 24px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px;
  background: var(--neutral-subtle);
  color: var(--text-muted);
  border: 2px solid var(--surface);
  box-shadow: 0 0 0 1px var(--border);
}

.ff-timeline__item.is-done .ff-timeline__dot { background: var(--success); color: #fff; box-shadow: 0 0 0 1px var(--success); }
.ff-timeline__item.is-current .ff-timeline__dot { background: var(--warning-subtle); color: var(--warning); box-shadow: 0 0 0 1px var(--warning); animation: ff-pulse 2s infinite; }
.ff-timeline__item.is-rejected .ff-timeline__dot { background: var(--danger); color: #fff; box-shadow: 0 0 0 1px var(--danger); }

@keyframes ff-pulse {
  0%, 100% { box-shadow: 0 0 0 1px var(--warning); }
  50% { box-shadow: 0 0 0 5px var(--warning-subtle); }
}

.ff-timeline__title { font-size: 13.5px; font-weight: 600; color: var(--text-primary); }
.ff-timeline__meta { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.ff-timeline__remarks { font-size: 12.5px; color: var(--text-secondary); margin-top: var(--space-2); background: var(--bg-inset); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); }

/* -------------------------------------------------------------------------
   10. Modal / dialog
   ------------------------------------------------------------------------- */
.ff-modal-backdrop {
  position: fixed; inset: 0;
  background: rgba(8, 10, 14, 0.55);
  display: flex; align-items: center; justify-content: center;
  padding: var(--space-4);
  z-index: 100;
}

.ff-modal {
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 460px;
  border: 1px solid var(--border);
}

.ff-modal__header { padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
.ff-modal__body { padding: var(--space-6); }
.ff-modal__footer { padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-3); }

/* -------------------------------------------------------------------------
   11. Toasts / notifications
   ------------------------------------------------------------------------- */
.ff-toast-stack { position: fixed; top: var(--space-5); right: var(--space-5); z-index: 200; display: flex; flex-direction: column; gap: var(--space-3); }

.ff-toast {
  display: flex; align-items: flex-start; gap: var(--space-3);
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--primary);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  padding: var(--space-4);
  width: 320px;
}

.ff-toast--success { border-left-color: var(--success); }
.ff-toast--danger { border-left-color: var(--danger); }
.ff-toast--warning { border-left-color: var(--warning); }

.ff-toast__title { font-size: 13px; font-weight: 600; }
.ff-toast__body { font-size: 12.5px; color: var(--text-secondary); margin-top: 2px; }

.ff-notif-panel {
  position: absolute; top: calc(var(--topbar-h) + 6px); right: var(--space-6);
  width: 340px; max-height: 420px; overflow-y: auto;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-md); box-shadow: var(--shadow-lg);
  z-index: 50;
}

.ff-notif-item { padding: var(--space-4); border-bottom: 1px solid var(--border); }
.ff-notif-item:last-child { border-bottom: none; }
.ff-notif-item.is-unread { background: var(--primary-subtle); }

/* -------------------------------------------------------------------------
   12. Alerts (django messages)
   ------------------------------------------------------------------------- */
.ff-alert {
  display: flex; align-items: center; gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid;
  font-size: 13.5px;
  font-weight: 500;
  margin-bottom: var(--space-4);
}

.ff-alert--success { background: var(--success-subtle); color: var(--success); border-color: var(--success-border); }
.ff-alert--error   { background: var(--danger-subtle); color: var(--danger); border-color: var(--danger-border); }
.ff-alert--warning { background: var(--warning-subtle); color: var(--warning); border-color: var(--warning-border); }
.ff-alert--info    { background: var(--info-subtle); color: var(--info); border-color: var(--info-border); }

/* -------------------------------------------------------------------------
   13. Utilities
   ------------------------------------------------------------------------- */
.ff-flex { display: flex; }
.ff-items-center { align-items: center; }
.ff-justify-between { justify-content: space-between; }
.ff-gap-2 { gap: var(--space-2); }
.ff-gap-3 { gap: var(--space-3); }
.ff-gap-4 { gap: var(--space-4); }
.ff-mb-2 { margin-bottom: var(--space-2); }
.ff-mb-4 { margin-bottom: var(--space-4); }
.ff-mb-6 { margin-bottom: var(--space-6); }
.ff-text-muted { color: var(--text-muted); }
.ff-text-secondary { color: var(--text-secondary); }
.ff-text-sm { font-size: 12.5px; }
.ff-w-full { width: 100%; }
</file>

<file path="static/js/app-shell.js">
(function () {
  "use strict";

  // ---- Theme toggle -------------------------------------------------
  function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    document.querySelectorAll("[data-theme-toggle] i").forEach(function (icon) {
      icon.className = theme === "dark" ? "bi bi-sun" : "bi bi-moon-stars";
    });
  }

  function initTheme() {
    var stored = localStorage.getItem("ff-theme");
    applyTheme(stored || document.documentElement.getAttribute("data-theme") || "light");

    document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        localStorage.setItem("ff-theme", next);
        applyTheme(next);
      });
    });
  }

  // ---- Sidebar collapse / mobile toggle ------------------------------
  function initSidebar() {
    var shell = document.querySelector(".ff-shell");
    if (!shell) return;

    var collapsed = localStorage.getItem("ff-sidebar-collapsed") === "1";
    if (collapsed) shell.classList.add("is-collapsed");

    document.querySelectorAll("[data-sidebar-collapse]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        shell.classList.toggle("is-collapsed");
        localStorage.setItem(
          "ff-sidebar-collapsed",
          shell.classList.contains("is-collapsed") ? "1" : "0"
        );
      });
    });

    document.querySelectorAll("[data-sidebar-mobile-toggle]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        shell.classList.toggle("is-mobile-open");
      });
    });
  }

  // ---- Notification panel toggle -------------------------------------
  function initNotifPanel() {
    var trigger = document.querySelector("[data-notif-trigger]");
    var panel = document.querySelector("[data-notif-panel]");
    if (!trigger || !panel) return;

    trigger.addEventListener("click", function (e) {
      e.stopPropagation();
      panel.style.display = panel.style.display === "block" ? "none" : "block";
    });

    document.addEventListener("click", function (e) {
      if (!panel.contains(e.target) && e.target !== trigger) {
        panel.style.display = "none";
      }
    });
  }

  // ---- Auto-dismiss toasts --------------------------------------------
  function initToasts() {
    document.querySelectorAll(".ff-toast").forEach(function (toast) {
      setTimeout(function () {
        toast.style.transition = "opacity 200ms";
        toast.style.opacity = "0";
        setTimeout(function () { toast.remove(); }, 200);
      }, 5000);
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    initTheme();
    initSidebar();
    initNotifPanel();
    initToasts();
  });
})();
</file>

