    )

    password = request.POST.get(
        "password",
    )

    user = authenticate(
        request,
        username=request.user.email,
        password=password,
    )

    if user is None:

        messages.error(
            request,
            "Incorrect password.",
        )

        return redirect(
            "request-detail",
            submission.pk,
        )

    WorkflowService.approve(
        step,
        request.user,
        remarks,
    )

    messages.success(
        request,
        "Request approved successfully.",
    )

    return redirect(
        "approval-inbox"
    )


