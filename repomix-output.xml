<file path="templates/notifications/list.html">
{% extends "base.html" %}

{% block title %}Notifications{% endblock %}
{% block topbar_title %}Notifications{% endblock %}

{% block content %}
<div class="ff-card">
    <div class="ff-card__header" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <div>
            <h2 class="ff-card__title">Your notifications</h2>
            <p class="ff-text-sm ff-text-muted">Newest activity appears first.</p>
        </div>
        {% if unread_count %}
        <form method="post" action="{% url 'notifications:mark-all-read' %}">
            {% csrf_token %}
            <button type="submit" class="ff-btn ff-btn--secondary">Mark all as read</button>
        </form>
        {% endif %}
    </div>

    {% if notifications %}
        <div class="ff-stack" style="gap: 12px;">
            {% for notification in notifications %}
                <div class="ff-card ff-card--bordered" style="padding: 16px; {% if not notification.is_read %}border-left: 4px solid var(--ff-primary);{% endif %}">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
                        <div>
                            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                <strong>{{ notification.title }}</strong>
                                {% if not notification.is_read %}
                                    <span class="ff-badge">Unread</span>
                                {% endif %}
                            </div>
                            {% if notification.message %}
                                <p class="ff-text-sm" style="margin: 6px 0 0;">{{ notification.message }}</p>
                            {% endif %}
                            <p class="ff-text-sm ff-text-muted" style="margin: 6px 0 0;">
                                {{ notification.created_at|date:"M d, Y H:i" }}
                            </p>
                        </div>
                        {% if not notification.is_read %}
                            <form method="post" action="{% url 'notifications:mark-read' notification.pk %}">
                                {% csrf_token %}
                                <button type="submit" class="ff-btn ff-btn--secondary">Mark read</button>
                            </form>
                        {% endif %}
                    </div>
                    {% if notification.workflow_instance and notification.workflow_instance.formsubmission %}
                        <div style="margin-top: 10px;">
                            <a href="{% url 'request-detail' notification.workflow_instance.formsubmission.pk %}" class="ff-link">Open request</a>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="ff-empty-state">
            <p>No notifications yet.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
</file>

<file path="templates/base.html">
{% load static %}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %} · ForgeFlow</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{% static 'css/design-system.css' %}" rel="stylesheet">
    <!-- Bootstrap above is a fallback for pages not yet migrated to the ForgeFlow
         design system (approval inbox, my requests, employee list, etc). Pages
         using ff-* classes render fully in the new system regardless. -->

    <script>
        (function () {
            var t = localStorage.getItem("ff-theme");
            if (t) document.documentElement.setAttribute("data-theme", t);
        })();
    </script>
    {% block extra_head %}{% endblock %}
</head>
<body>

<div class="ff-shell">

    <aside class="ff-sidebar">
        {% include "includes/sidebar.html" %}
    </aside>

    <div class="ff-main">
        <header class="ff-topbar">
            <div class="ff-topbar__left">
                <button class="ff-icon-btn d-none d-md-inline-flex" data-sidebar-collapse title="Collapse sidebar">
                    <i class="bi bi-layout-sidebar"></i>
                </button>
                <button class="ff-icon-btn d-inline-flex d-md-none" data-sidebar-mobile-toggle title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="ff-topbar__title">{% block topbar_title %}{% endblock %}</span>
            </div>

            <div class="ff-topbar__right" style="position: relative;">
                <button class="ff-icon-btn" data-theme-toggle title="Toggle theme">
                    <i class="bi bi-moon-stars"></i>
                </button>

                <a href="{% url 'notifications:list' %}" class="ff-icon-btn" data-notif-trigger title="Notifications" style="position: relative; text-decoration: none;">
                    <i class="bi bi-bell"></i>
                    {% if unread_notifications %}
                        <span class="ff-badge" style="position: absolute; top: 2px; right: 2px;">{{ unread_notifications }}</span>
                    {% endif %}
                </a>
                <div class="ff-notif-panel" data-notif-panel style="display:none;">
                    <div class="ff-notif-item ff-text-sm ff-text-muted" style="text-align:center; padding: 24px;">
                        {% if unread_notifications %}
                            You have {{ unread_notifications }} unread notification{{ unread_notifications|pluralize }}.
                        {% else %}
                            No new notifications
                        {% endif %}
                    </div>
                </div>

                <div class="ff-avatar" title="{{ request.user.get_full_name }}">
                    {{ request.user.first_name|slice:":1" }}{{ request.user.last_name|slice:":1" }}
                </div>
            </div>
        </header>

        <main class="ff-content">
            {% if messages %}
                {% for message in messages %}
                <div class="ff-alert ff-alert--{{ message.tags|default:'info' }}">
                    <i class="bi bi-info-circle"></i>
                    <span>{{ message }}</span>
                </div>
                {% endfor %}
            {% endif %}

            {% block content %}{% endblock %}
        </main>
    </div>

</div>

