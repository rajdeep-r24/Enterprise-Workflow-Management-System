<file path="forms_engine/templates/forms_engine/request_detail.html">
{% extends "base.html" %}

{% block title %}
Request Details
{% endblock %}

{% block content %}

<div class="row">

    <div class="col-lg-8">

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h3>{{ submission.form.name }}</h3>

            </div>

            <div class="card-body">

                <table class="table">

                    <tbody>

                    {% for item in values %}

                    <tr>

                        <th width="35%">

                            {{ item.field.label }}

                        </th>

                        <td>

                            {{ item.value }}

                        </td>

                    </tr>

                    {% endfor %}

                    </tbody>

                </table>

                <hr>

                {% if submission.attachments.exists %}
                <div class="mb-4">
                    <h5 class="mb-3">Attachments</h5>
                    <ul class="list-group">
                        {% for attachment in submission.attachments.all %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>{{ attachment.original_filename }}</strong><br>
                                <small class="text-muted">Uploaded by {{ attachment.uploaded_by.get_full_name|default:attachment.uploaded_by.email }} on {{ attachment.uploaded_at|date:"M d, Y H:i" }}</small>
                            </div>
                            <a href="{% url 'download-attachment' attachment.pk %}" class="btn btn-sm btn-outline-primary" target="_blank">
                                Download
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                <hr>
                {% endif %}

                <p>

                    <strong>Status :</strong>

                    <span class="badge bg-primary">

                        {{ submission.status }}

                    </span>

                </p>

                <p>

                    <strong>Current Step :</strong>

                    {{ submission.workflow_instance.current_step.name|default:"Completed" }}

                </p>

                {% if submission.status == "APPROVED" %}

                <div class="mt-4">

                    <a
                        href="{% url 'permission-pdf' submission.pk %}"
                        target="_blank"
                        class="btn btn-primary">

                        Print Permission

                    </a>

                </div>

                {% endif %}

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm">

            <div class="card-header">

                <h5>Workflow Timeline</h5>

            </div>

            <div class="card-body">

                {% for event in events %}

                    <div class="border-start border-3 border-primary ps-3 mb-4">

                        <strong>

                            {{ event.get_event_type_display }}

                        </strong> 

                        <br>

                        {% if event.performed_by %}

                            {{ event.performed_by.get_full_name }}

                            <br>

                        {% endif %}

                        <small class="text-muted">

                            {{ event.created_at }}

                        </small>

                        {% if event.remarks %}

                            <br>

                            <small>

                                {{ event.remarks }}

                            </small>

                        {% endif %}

                    </div>

                {% empty %}

                    <p class="text-muted">

                        No activity available.

                    </p>

                {% endfor %}

            </div>

        </div>

    </div>

</div>

{% if can_take_action %}

<hr>

<div class="card shadow-sm mt-4">

    <div class="card-header">
        <h5>Approval Action</h5>
    </div>

    <div class="card-body">

        <button
            class="btn btn-success me-2"
            data-bs-toggle="modal"
            data-bs-target="#approveModal">

            Approve

        </button>

        <button
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#rejectModal">

